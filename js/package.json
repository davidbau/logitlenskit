{
  "name": "logit-lens-widget",
  "version": "0.1.0",
  "description": "Interactive logit lens visualization widget for transformer models",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/unit/",
    "test:integration": "jest tests/integration/ --runInBand",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:browser": "npx playwright test widget-rendering widget-api-features",
    "test:browser:headed": "npx playwright test widget-rendering widget-api-features --headed",
    "test:browser:debug": "npx playwright test --debug",
    "test:colab": "./scripts/run-colab-tests.sh",
    "test:colab:setup": "npx playwright test tests/browser/colab-auth-setup.spec.js --headed",
    "test:jupyter": "npx playwright test jupyter-local.spec.js",
    "test:jupyter:headed": "npx playwright test jupyter-local.spec.js --headed",
    "test:ndif": "npx playwright test jupyter-local.spec.js",
    "build": "esbuild src/logit-lens-widget.js --minify --outfile=dist/logit-lens-widget.min.js",
    "lint": "eslint src/ tests/",
    "callgraph": "node build/build-callgraph.js",
    "dataflow": "node build/build-dataflow.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "serve": "^14.2.5"
  },
  "license": "MIT",
  "dependencies": {
    "acorn-loose": "^8.5.2"
  }
}
